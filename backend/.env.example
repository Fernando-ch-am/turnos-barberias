NODE_ENV=development
PORT=4000

# Connection string de Supabase (Project Settings > Database). Nunca commitear la real.
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres
# Supabase exige SSL. Poner false solo para un Postgres local sin SSL.
DB_SSL=true

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:3000

# Lo usa el módulo auth
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1d
